y0 = 10         # initial value of the process
a0 = 1          # intercept parameter
a2 = 0.05       # slope parameter
nobs = 100      # sample size (nobs)
# Simulate error term by generating 100 random draws from N(0,1)
eps = ts(rnorm(nobs), start = 1, end = nobs)
# Simulate stochastic trend and time variable
st = ts(cumsum(eps), start = 1, end = nobs)
t = (1:nobs)   # A number sequence from 1 to 100
# Simulate a pure random walk (y.rw)
y.rw = ts(y0 + st, start = 1, end = nobs)
# Simulate a random walk with drift (y.rwd)
r.rwd = ts(y0 + a0*t + st, start = 1, end = nobs)
# Simulate a random walk with drift and trend (y.rwdt)
r.rwdt = ts(y0 + (a0+a2/t)*t + (a2/2)*t^2 + st, start = 1, end = nobs)
plot.ts(y.rwdt, col = "red", ylim = c(-50, 350))
