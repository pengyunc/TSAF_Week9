ntrials = 10000      # Perform the simulation 10000 times
# Set up empty containers for storing test statistic values
DF1 = rep(NA, ntrials)
DF2 = rep(NA, ntrials)
DF3 = rep(NA, ntrials)
# Run the simulation (i.e. part a) 10000 times
for (i in 1:ntrials){
# Simulate error term and construct cumulative sum
eps = ts(rnorm(nobs), start = 1, end = nobs)
st = ts(cumsum(eps), start = 1, end = nobs)
# Simulate the three random walk processes
y.rw = ts(y0 + st, start = 1, end = nobs)
y.rwd = ts(y0 + a0*t + st, start = 1, end = nobs)
y.rwdt = ts(y0 + (a0 + a2/t)*t + (a2/2)*t^2 + st, start = 1, end = nobs)
# Conduct the DF tau-tests and retrieve the tau-test statistics
DF1[i] = ur.df(y.rw, lags = 0, type = "none")@testreg$coefficients[1,3]
DF2[i] = ur.df(y.rwd, lags = 0,type = "drift")@testreg$coefficients[2,3]
DF3[i] = ur.df(y.rwdt, lags = 0,type = "trend")@testreg$coefficients[2,3]
}
hist(DF1, freq = FALSE, breaks = 100)
lines(density(DF1), lwd = 2, col = 'red')
hist(DF1, freq = FALSE, breaks = 100)
lines(density(DF1), lwd = 2, col = 'red')
